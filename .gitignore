# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Virtualenv (uv.lock is the reproducibility source of truth; .venv is not tracked) ---
.venv/

# --- Tool caches ---
.ruff_cache/
.pytest_cache/
.mypy_cache/

# --- Coverage instrumentation (p8c2 T0) — the .coverage SQLite DB and any
#     html/xml export are measurement RESIDUE, regenerated by one command
#     (`coverage run -m pytest`); committing them would let a stale number
#     outlive the code it described. The CONFIG is not residue and is not here:
#     it lives in pyproject.toml [tool.coverage.*]. ⚠ this glob also swallows a
#     `.coveragerc` — intentional, that file must not exist (two config sources
#     drift, and the loser is silent). ---
.coverage*

# --- Local env / secrets (.env.example IS tracked — only the live .env is ignored) ---
.env

# --- Verification run outputs & caches (stateless: results/cache are mounted, not committed) ---
results/
*.mcap
*.mp4
*.log
