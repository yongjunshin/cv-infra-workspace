; import-linter configuration — the one boundary this package enforces.
;
; ``cv_infra.contract`` is the foundational layer: the input contract, the case
; derivation and the verdict typing must be readable and testable without dragging in
; docker, the baseline store, the report or the CLI. Every other module may depend on
; the contract; the contract depends on none of them.
;
; Encoded as ``forbidden`` rather than ``layers`` on purpose: the siblings are free to
; order their own dependencies (the CLI drives execution, report and baselines), and
; only the contract-is-lowest boundary is asserted — the rule we actually need.

[importlinter]
root_package = cv_infra

[importlinter:contract:contract-is-foundational]
name = cv_infra.contract is the foundational layer (imports no sibling module)
type = forbidden
source_modules =
    cv_infra.contract
forbidden_modules =
    cv_infra.execution
    cv_infra.baselines
    cv_infra.report
    cv_infra.cli
