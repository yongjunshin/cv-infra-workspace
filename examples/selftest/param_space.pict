# cv-infra selftest input space (Microsoft PICT model).
#
# Each parameter is an AXIS, and each axis becomes `--<name>=<value>` on sim.py's own
# command line, in the declaration order below — so an axis name must be a legal long
# flag and must not collide with argparse's own `help`/`h`.
#
# 3 x 2 = 6 combinations; pairwise (pict_k: 2) covers them all here, which is what makes
# this a selftest: it always runs the whole grid.
drop_height: 0.5, 1.5, 3.0
cube_scale: 0.2, 0.5
